# Only this one is required:
TMDB_API_KEY=your_tmdb_v3_key_or_v4_read_token

# Optional (sensible defaults / auto-generated if left out):
# ADMIN_TOKEN=
# SIGNING_SECRET=
# PUBLIC_BASE_URL=https://candy.example.com
# PORT=8000
# BIND_ADDRESS=0.0.0.0              # 127.0.0.1 = reachable only through your HTTPS reverse proxy (recommended in production)
# POSTGRES_PASSWORD=
# LIBRARY_TTL_HOURS=24
# LIBRARY_MAX_SIZE_GB=20
# LIBRARY_CONCURRENCY=2
# TELEGRAM_BOT_TOKEN=               # optional first-time values for Telegram alerts (afterwards use admin -> Telegram)
# TELEGRAM_CHAT_ID=
# SERVER_NAME=vps-1                 # shown in Telegram messages
# LIVE_ENABLED=true                 # live relay: play a source's stream through candyresolver, nothing saved
# LIVE_MAX_SESSIONS=10              # different streams watched at the same time (each costs the VPS the stream's bandwidth)
# AUDIO_CONCURRENCY=2               # simultaneous GET /v1/library/{id}/audio extractions
# Progressive HLS (play while downloading):
# CORS_ORIGINS=https://candyflix.example      # default * (any website may load the playlists/segments)
# HLS_LINK_TTL_MIN=720
# PROGRESSIVE_SEGMENT_SECONDS=4
# PROGRESSIVE_MIN_SEGMENTS=3
# Subtitles (downloaded next to the video, converted to WebVTT, served from our own signed links):
# SUBTITLES_ENABLED=true            # a library request can override with "subtitles": true/false
# SUBTITLE_MAX_FILES=30             # per item
# SUBTITLE_MAX_BYTES=2097152        # per file (2 MB), enforced while downloading
# SUBTITLE_TIMEOUT_S=15             # per file
# SUBTITLE_CONCURRENCY=4            # simultaneous downloads, server-wide
# SUBTITLE_LANGS=en,fa              # allow-list; empty = every language; a request's "subtitle_langs" overrides it
# SUBTITLE_DEFAULT_LANG=en          # mark this language's first track as default; empty = never
# SUBTITLE_FFMPEG_FALLBACK=true     # ASS/SSA files go through ffmpeg; false = skip them (SRT/VTT never use ffmpeg)

# TASK_TTL_HOURS=24
# TASK_RETENTION_DAYS=365
# SUBTITLE_PACK_TTL_HOURS=168

# HLS_SEND_CUSTOM_HEADERS=false      # false = ffmpeg gets no custom headers/User-Agent for HLS (like a hand-run ffmpeg)

# --- memory protection (a browser source needs ~400 MB; a 1 GB server can run one at a time) ---
# MAX_CONCURRENT_TASKS=2     # tasks running at once; extra requests wait (status "queued", with queue_position)
# MAX_QUEUED_TASKS=20        # waiting tasks beyond this get HTTP 429 + Retry-After
# MAX_BROWSER_SCRIPTS=1      # browser-based sources running at once across ALL tasks (0 = unlimited)
# API_MEM_LIMIT=700m         # container memory cap: on a 1 GB server use ~700m so only the api container is restarted on overload
